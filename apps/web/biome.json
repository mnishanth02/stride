{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "extends": "//",
  "files": {
    "includes": ["**/*.{css,js,mjs,cjs,jsx,ts,tsx,json,jsonc}"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva"]
          }
        }
      }
    }
  }
}
