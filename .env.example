# =============================================================================
# Stride — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled URL for runtime queries (used by the app at request time)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# Direct URL for migrations and admin operations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# -----------------------------------------------------------------------------
# Client-visible Clerk config
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
# Disable Clerk's dev-time keyless fallback so missing/invalid keys fail loudly
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED="true"

# Server-side Clerk config
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Server aliases kept in sync with the public auth routes above
CLERK_SIGN_IN_URL="/sign-in"
CLERK_SIGN_UP_URL="/sign-up"
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# -----------------------------------------------------------------------------
# File Storage (Cloudflare R2 via S3-compatible API)
# -----------------------------------------------------------------------------
S3_UPLOAD_KEY="your-r2-access-key-id"
S3_UPLOAD_SECRET="your-r2-secret-access-key"
S3_UPLOAD_BUCKET="stride-uploads"
S3_UPLOAD_REGION="auto"
S3_UPLOAD_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Public URL for serving uploaded assets (Cloudflare R2 public bucket or custom domain)
S3_UPLOAD_PUBLIC_URL="https://assets.example.com"

# -----------------------------------------------------------------------------
# Analytics (PostHog)
# -----------------------------------------------------------------------------
# Set to "true" to enable PostHog analytics; leave "false" during development
NEXT_PUBLIC_POSTHOG_ENABLED="false"
# Client-visible — prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_POSTHOG_TOKEN="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
